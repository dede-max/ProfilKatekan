<div class="fixed top-20 right-4 z-50 space-y-2 max-w-sm w-full pointer-events-none">
  <% if (success && success.length > 0) { %>
    <% success.forEach(msg => { %>
      <div class="flash-msg pointer-events-auto flex items-start gap-3 bg-white border-l-4 border-primary-500 rounded-xl shadow-lg px-4 py-3 animate-slide-up">
        <svg class="w-5 h-5 text-primary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="flex-1 text-sm text-gray-700 font-medium"><%= msg %></p>
        <button class="flash-close text-gray-400 hover:text-gray-600 transition-colors ml-2 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    <% }) %>
  <% } %>

  <% if (error && error.length > 0) { %>
    <% error.forEach(msg => { %>
      <div class="flash-msg pointer-events-auto flex items-start gap-3 bg-white border-l-4 border-red-500 rounded-xl shadow-lg px-4 py-3 animate-slide-up">
        <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="flex-1 text-sm text-gray-700 font-medium"><%= msg %></p>
        <button class="flash-close text-gray-400 hover:text-gray-600 transition-colors ml-2 flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    <% }) %>
  <% } %>
</div>
