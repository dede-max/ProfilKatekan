<% layout('layouts/main') %>

<!-- Page Header -->
<section class="hero-gradient py-20 relative overflow-hidden">
  <div class="container-wrap text-center relative z-10" data-aos="fade-up">
    <span class="badge bg-primary-400/20 text-primary-300 mb-4">Potensi Dusun</span>
    <h1 class="text-4xl lg:text-5xl font-extrabold text-white mb-3 text-shadow">Potensi Dusun Katekan</h1>
    <p class="text-primary-200 text-lg max-w-xl mx-auto">Keunggulan dan kekayaan Dusun Katekan yang terus dikembangkan.</p>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 50" fill="white" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0 50L1440 50L1440 20C1200 40 960 50 720 50C480 50 240 35 0 20V50Z"/></svg>
  </div>
</section>

<!-- Filter Kategori -->
<section class="py-8 bg-white sticky top-16 z-20 border-b border-gray-100 shadow-sm">
  <div class="container-wrap">
    <div class="flex gap-2 overflow-x-auto pb-1 scrollbar-hide">
      <a href="/potensi"
         class="flex-shrink-0 px-5 py-2 rounded-full text-sm font-semibold transition-all
                <%= !activeKategori ? 'bg-primary-700 text-white shadow-md' : 'bg-gray-100 text-gray-600 hover:bg-primary-50 hover:text-primary-700' %>">
        Semua
      </a>
      <% kategoriList.forEach(kat => { %>
        <a href="/potensi?kategori=<%= encodeURIComponent(kat) %>"
           class="flex-shrink-0 px-5 py-2 rounded-full text-sm font-semibold transition-all
                  <%= activeKategori === kat ? 'bg-primary-700 text-white shadow-md' : 'bg-gray-100 text-gray-600 hover:bg-primary-50 hover:text-primary-700' %>">
          <%= kat %>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Daftar Potensi -->
<section class="section-pad bg-gray-50">
  <div class="container-wrap">
    <% if (potensi && potensi.length > 0) { %>
      <% if (activeKategori) { %>
        <div class="mb-8" data-aos="fade-up">
          <p class="text-gray-500 text-sm">Menampilkan <strong class="text-gray-800"><%= potensi.length %></strong> potensi kategori <strong class="text-primary-700"><%= activeKategori %></strong></p>
        </div>
      <% } %>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% const katColors = { 'Pertanian': 'badge-green', 'UMKM': 'badge-amber', 'Wisata': 'badge-blue', 'Perikanan': 'bg-cyan-100 text-cyan-700 badge', 'Budaya': 'bg-purple-100 text-purple-700 badge', 'Lainnya': 'bg-gray-100 text-gray-600 badge' } %>
        <% potensi.forEach((p, i) => { %>
          <a href="/potensi/<%= p.slug %>" class="card group" data-aos="fade-up" data-aos-delay="<%= (i % 3) * 80 %>">
            <div class="relative overflow-hidden h-52">
              <% if (p.foto) { %>
                <img src="<%= p.foto %>" alt="<%= p.judul %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              <% } else { %>
                <div class="w-full h-full bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center">
                  <span class="text-6xl">🌾</span>
                </div>
              <% } %>
              <div class="absolute top-3 left-3">
                <span class="<%= katColors[p.kategori] || 'badge bg-gray-100 text-gray-600' %> shadow-sm text-xs"><%= p.kategori || 'Lainnya' %></span>
              </div>
            </div>
            <div class="p-5">
              <h3 class="font-bold text-gray-900 mb-2 text-lg group-hover:text-primary-700 transition-colors"><%= p.judul %></h3>
              <p class="text-sm text-gray-500 leading-relaxed line-clamp-2"><%= p.deskripsi_singkat || '' %></p>
              <div class="mt-4 flex items-center text-primary-600 text-sm font-semibold gap-1">
                Selengkapnya
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </div>
            </div>
          </a>
        <% }) %>
      </div>

    <% } else { %>
      <div class="text-center py-20" data-aos="fade-up">
        <div class="text-6xl mb-4">🔍</div>
        <h3 class="text-xl font-bold text-gray-700 mb-2">Tidak ada data potensi</h3>
        <p class="text-gray-400">
          <% if (activeKategori) { %>
            Tidak ada potensi kategori "<strong><%= activeKategori %></strong>".
            <a href="/potensi" class="text-primary-600 hover:underline">Lihat semua potensi</a>
          <% } else { %>
            Data potensi belum tersedia. Silakan tambahkan melalui panel admin.
          <% } %>
        </p>
      </div>
    <% } %>
  </div>
</section>
