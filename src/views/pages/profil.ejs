<% layout('layouts/main') %>

<!-- Page Header -->
<section class="hero-gradient py-20">
  <div class="container-wrap text-center" data-aos="fade-up">
    <span class="badge bg-primary-400/20 text-primary-300 mb-4">Profil Dusun</span>
    <h1 class="text-4xl lg:text-5xl font-extrabold text-white mb-3 text-shadow">Profil Dusun Katekan</h1>
    <p class="text-primary-200 text-lg max-w-xl mx-auto">Mengenal lebih dekat Dusun Katekan — sejarah, visi-misi, dan pemerintahannya.</p>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 50" fill="white" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0 50L1440 50L1440 20C1200 40 960 50 720 50C480 50 240 35 0 20V50Z"/></svg>
  </div>
</section>

<!-- Sejarah -->
<section class="section-pad bg-white" id="sejarah">
  <div class="container-wrap">
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div data-aos="fade-right">
        <span class="badge-green mb-4">Sejarah</span>
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Sejarah Dusun Katekan</h2>
        <div class="prose prose-gray text-gray-600 leading-relaxed space-y-4">
          <% if (profil?.sejarah) { %>
            <% profil.sejarah.split('\n').forEach(p => { %>
              <% if (p.trim()) { %><p><%= p.trim() %></p><% } %>
            <% }) %>
          <% } else { %>
            <p>Informasi sejarah dusun belum tersedia. Silakan update melalui panel admin.</p>
          <% } %>
        </div>
      </div>

      <div data-aos="fade-left">
        <!-- Info Dusun -->
        <div class="bg-gray-50 rounded-2xl p-6">
          <h3 class="font-bold text-gray-900 mb-5 text-lg">Informasi Dusun</h3>
          <dl class="space-y-3">
            <% const infoItems = [
              ['Nama Dusun', profil?.nama_desa],
              ['Kecamatan', profil?.kecamatan],
              ['Kabupaten', profil?.kabupaten],
              ['Provinsi', profil?.provinsi],
              ['Kode Pos', profil?.kode_pos],
              ['Luas Wilayah', profil?.luas_wilayah ? profil.luas_wilayah.toLocaleString('id') + ' Ha' : null],
              ['Jumlah Penduduk', profil?.jumlah_penduduk ? profil.jumlah_penduduk.toLocaleString('id') + ' Jiwa' : null],
              ['Jumlah KK', profil?.jumlah_kk ? profil.jumlah_kk.toLocaleString('id') + ' KK' : null],
              ['Alamat Kantor', profil?.alamat_kantor],
              ['Telepon', profil?.telepon],
              ['Email', profil?.email_desa],
            ] %>
            <% infoItems.forEach(([label, value]) => { %>
              <% if (value) { %>
                <div class="flex gap-3 py-2 border-b border-gray-100 last:border-0">
                  <dt class="w-36 text-sm text-gray-400 font-medium flex-shrink-0"><%= label %></dt>
                  <dd class="text-sm text-gray-700 font-semibold flex-1"><%= value %></dd>
                </div>
              <% } %>
            <% }) %>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Visi & Misi -->
<section class="section-pad bg-gray-50" id="visi-misi">
  <div class="container-wrap">
    <div class="text-center mb-12" data-aos="fade-up">
      <span class="badge-green mb-3">Arah & Tujuan</span>
      <h2 class="section-heading">Visi & Misi</h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      <!-- Visi -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border-t-4 border-primary-600" data-aos="fade-right">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900">Visi</h3>
        </div>
        <p class="text-gray-600 leading-relaxed italic text-lg"><%= profil?.visi || 'Visi dusun belum diisi.' %></p>
      </div>

      <!-- Misi -->
      <div class="bg-white rounded-2xl p-8 shadow-sm border-t-4 border-amber-500" data-aos="fade-left">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900">Misi</h3>
        </div>
        <% if (profil?.misi) { %>
          <ol class="space-y-2">
            <% profil.misi.split('\n').forEach(line => { %>
              <% if (line.trim()) { %>
                <li class="flex gap-2 text-gray-600 text-sm">
                  <span class="text-amber-500 flex-shrink-0">•</span>
                  <%= line.replace(/^\d+\.\s*/, '').trim() %>
                </li>
              <% } %>
            <% }) %>
          </ol>
        <% } else { %>
          <p class="text-gray-500">Misi dusun belum diisi.</p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- Perangkat Dusun -->
<% if (perangkat && perangkat.length > 0) { %>
<section class="section-pad bg-white" id="perangkat">
  <div class="container-wrap">
    <div class="text-center mb-12" data-aos="fade-up">
      <span class="badge-green mb-3">Pemerintahan</span>
      <h2 class="section-heading">Perangkat Dusun</h2>
      <p class="section-sub">Jajaran pemerintahan yang berdedikasi melayani masyarakat Dusun Katekan.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
      <% perangkat.forEach((p, i) => { %>
        <div class="text-center p-6 bg-gray-50 rounded-2xl hover:shadow-md transition-shadow group" data-aos="fade-up" data-aos-delay="<%= (i % 4) * 60 %>">
          <div class="w-24 h-24 mx-auto mb-4 rounded-full overflow-hidden ring-4 ring-white shadow-lg">
            <% if (p.foto) { %>
              <img src="<%= p.foto %>" alt="<%= p.nama %>" class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full bg-gradient-to-br from-primary-200 to-primary-400 flex items-center justify-center text-primary-800 font-bold text-3xl">
                <%= p.nama.charAt(0) %>
              </div>
            <% } %>
          </div>
          <h4 class="font-bold text-gray-900 text-sm leading-snug mb-1"><%= p.nama %></h4>
          <span class="text-xs font-semibold text-primary-600 bg-primary-50 px-3 py-1 rounded-full"><%= p.jabatan %></span>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
