<% layout('layouts/main') %>

<!-- ══ HERO ══════════════════════════════════════════════════ -->
<section class="relative hero-gradient min-h-[90vh] flex items-center overflow-hidden">
  <!-- Decorative circles -->
  <div class="absolute top-20 right-20 w-64 h-64 bg-white/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-20 left-10 w-96 h-96 bg-primary-400/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-wrap relative z-10 py-20">
    <div class="max-w-3xl">
      <span class="inline-block badge-green mb-6 text-sm py-1.5 px-4 bg-primary-400/20 text-primary-300 rounded-full font-medium" data-aos="fade-up">
        🌿 Website Resmi Dusun Katekan
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white mb-6 leading-tight text-shadow" data-aos="fade-up" data-aos-delay="100">
        Selamat Datang di<br>
        <span class="text-primary-300">Dusun Katekan</span>
      </h1>
      <p class="text-xl text-gray-300 mb-10 leading-relaxed max-w-xl" data-aos="fade-up" data-aos-delay="200">
        Kecamatan Gantiwarno, Kabupaten Klaten, Jawa Tengah. Dusun mandiri, sejahtera, dan berbudaya berlandaskan gotong royong.
      </p>
      <div class="flex flex-wrap gap-4" data-aos="fade-up" data-aos-delay="300">
        <a href="/profil" class="btn-primary bg-white text-primary-800 hover:bg-primary-50 shadow-xl">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Profil Dusun
        </a>
        <a href="/potensi" class="btn-secondary border-white/30 text-white hover:bg-white/10">
          Lihat Potensi
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Wave -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 40L60 46.7C120 53.3 240 66.7 360 66.7C480 66.7 600 53.3 720 46.7C840 40 960 40 1080 43.3C1200 46.7 1320 53.3 1380 56.7L1440 60V80H1380C1320 80 1200 80 1080 80C960 80 840 80 720 80C600 80 480 80 360 80C240 80 120 80 60 80H0V40Z" fill="white"/>
    </svg>
  </div>
</section>

<!-- ══ STATISTIK ════════════════════════════════════════════ -->
<% if (profil) { %>
<section class="py-12 bg-white">
  <div class="container-wrap">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      <% const stats = [
        { label: 'Luas Wilayah', value: profil.luas_wilayah ? profil.luas_wilayah.toLocaleString('id') + ' Ha' : '—', icon: '🗺️' },
        { label: 'Jumlah Penduduk', value: profil.jumlah_penduduk ? profil.jumlah_penduduk.toLocaleString('id') + ' Jiwa' : '—', icon: '👥' },
        { label: 'Jumlah KK', value: profil.jumlah_kk ? profil.jumlah_kk.toLocaleString('id') + ' KK' : '—', icon: '🏠' },
        { label: 'Kecamatan', value: profil.kecamatan || 'Gantiwarno', icon: '📍' },
      ] %>
      <% stats.forEach((s, i) => { %>
        <div class="text-center p-6 bg-primary-50 rounded-2xl" data-aos="fade-up" data-aos-delay="<%= i * 80 %>">
          <div class="text-3xl mb-2"><%= s.icon %></div>
          <div class="text-2xl font-bold text-primary-800 mb-1"><%= s.value %></div>
          <div class="text-sm text-gray-500 font-medium"><%= s.label %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ══ PROFIL SINGKAT ═══════════════════════════════════════ -->
<section class="section-pad bg-white">
  <div class="container-wrap">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div data-aos="fade-right">
        <span class="badge-green mb-4">Tentang Kami</span>
        <h2 class="section-heading">Mengenal Dusun Katekan</h2>
        <p class="text-gray-500 mb-6 leading-relaxed">
          <%= profil?.sejarah?.substring(0, 350) || 'Dusun Katekan adalah dusun yang kaya akan budaya dan potensi alam.' %>...
        </p>
        <% if (profil?.visi) { %>
          <div class="bg-primary-50 border-l-4 border-primary-600 rounded-r-xl p-5 mb-6">
            <p class="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-1">Visi Dusun</p>
            <p class="text-gray-700 font-medium text-sm leading-relaxed"><%= profil.visi %></p>
          </div>
        <% } %>
        <a href="/profil" class="btn-primary">Baca Selengkapnya</a>
      </div>

      <div data-aos="fade-left">
        <% if (profil?.foto_kantor) { %>
          <img src="<%= profil.foto_kantor %>" alt="Kantor Dusun Katekan" class="w-full h-72 object-cover rounded-3xl shadow-xl">
        <% } else { %>
          <div class="w-full h-72 bg-gradient-to-br from-primary-100 to-primary-200 rounded-3xl flex items-center justify-center">
            <div class="text-center text-primary-600">
              <svg class="w-24 h-24 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              <p class="text-sm font-medium opacity-60">Kantor Dusun Katekan</p>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ══ VIDEO PROFIL DUSUN ══════════════════════════════════════ -->
<section class="section-pad bg-gradient-to-b from-white to-gray-50 relative overflow-hidden" id="video-profil">
  <!-- Background glow -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-primary-100/50 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container-wrap relative z-10">
    <div class="text-center mb-10" data-aos="fade-up">
      <span class="badge-green mb-3">Dokumentasi Video</span>
      <h2 class="section-heading">Video Profil Dusun Katekan</h2>
      <p class="section-sub">Saksikan sekilas keindahan alam, keramahan warga, dan dinamika pembangunan di Dusun Katekan.</p>
    </div>

    <div class="max-w-4xl mx-auto" data-aos="zoom-in" data-aos-delay="100">
      <div class="relative rounded-3xl overflow-hidden shadow-2xl bg-gray-900 border-4 border-white/80 ring-1 ring-black/5 aspect-video flex items-center justify-center">
        <% if (profil?.video_file) { %>
          <!-- Video File Uploaded -->
          <video src="<%= profil.video_file %>" controls preload="metadata" class="w-full h-full object-cover">
            Browser Anda tidak mendukung tag video HTML5.
          </video>
        <% } else if (profil?.video_embed_url || profil?.video_url) { %>
          <!-- Video Embed (YouTube / Link) -->
          <iframe
            src="<%= profil.video_embed_url || profil.video_url %>"
            title="Video Profil Dusun Katekan"
            class="w-full h-full"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen>
          </iframe>
        <% } else { %>
          <!-- Placeholder saat belum ada video -->
          <div class="text-center p-8 text-white flex flex-col items-center justify-center">
            <div class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mb-4 backdrop-blur-sm ring-4 ring-white/20">
              <svg class="w-10 h-10 text-primary-300 ml-1" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </div>
            <h3 class="text-xl font-bold mb-2">Video Profil Dusun</h3>
            <p class="text-gray-300 text-sm max-w-md">Video profil resmi Dusun Katekan dapat ditambahkan melalui panel admin melalui tautan YouTube maupun file video.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- ══ POTENSI UNGGULAN ══════════════════════════════════════ -->
<% if (potensiList && potensiList.length > 0) { %>
<section class="section-pad bg-gray-50">
  <div class="container-wrap">
    <div class="text-center mb-12" data-aos="fade-up">
      <span class="badge-green mb-3">Potensi Dusun</span>
      <h2 class="section-heading">Potensi Unggulan</h2>
      <p class="section-sub">Berbagai potensi unggulan Dusun Katekan yang terus dikembangkan untuk meningkatkan kesejahteraan masyarakat.</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% const kategoriColors = { 'Pertanian': 'badge-green', 'UMKM': 'badge-amber', 'Wisata': 'badge-blue', 'Perikanan': 'bg-cyan-100 text-cyan-700 badge', 'Budaya': 'bg-purple-100 text-purple-700 badge', 'Lainnya': 'bg-gray-100 text-gray-600 badge' } %>
      <% potensiList.forEach((p, i) => { %>
        <a href="/potensi/<%= p.slug %>" class="card group" data-aos="fade-up" data-aos-delay="<%= (i % 3) * 80 %>">
          <div class="relative overflow-hidden h-48">
            <% if (p.foto) { %>
              <img src="<%= p.foto %>" alt="<%= p.judul %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            <% } else { %>
              <div class="w-full h-full bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center">
                <span class="text-5xl">🌾</span>
              </div>
            <% } %>
            <div class="absolute top-3 left-3">
              <span class="<%= kategoriColors[p.kategori] || 'badge bg-gray-100 text-gray-600' %> shadow-sm"><%= p.kategori || 'Lainnya' %></span>
            </div>
          </div>
          <div class="p-5">
            <h3 class="font-bold text-gray-900 mb-2 group-hover:text-primary-700 transition-colors"><%= p.judul %></h3>
            <p class="text-sm text-gray-500 line-clamp-2"><%= p.deskripsi_singkat || '' %></p>
            <div class="mt-4 flex items-center text-primary-600 text-sm font-semibold">
              Baca selengkapnya
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </div>
        </a>
      <% }) %>
    </div>

    <div class="text-center mt-10" data-aos="fade-up">
      <a href="/potensi" class="btn-secondary">Lihat Semua Potensi</a>
    </div>
  </div>
</section>
<% } %>

<!-- ══ PERANGKAT DUSUN ═══════════════════════════════════════ -->
<% if (perangkat && perangkat.length > 0) { %>
<section class="section-pad bg-white">
  <div class="container-wrap">
    <div class="text-center mb-12" data-aos="fade-up">
      <span class="badge-green mb-3">Tim Pemerintahan</span>
      <h2 class="section-heading">Perangkat Dusun</h2>
      <p class="section-sub">Jajaran pemerintahan Dusun Katekan yang berdedikasi melayani masyarakat.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5">
      <% perangkat.forEach((p, i) => { %>
        <div class="text-center p-5 bg-gray-50 rounded-2xl hover:bg-primary-50 transition-colors group" data-aos="fade-up" data-aos-delay="<%= (i % 4) * 60 %>">
          <div class="w-20 h-20 mx-auto mb-3 rounded-full overflow-hidden ring-4 ring-white shadow-md">
            <% if (p.foto) { %>
              <img src="<%= p.foto %>" alt="<%= p.nama %>" class="w-full h-full object-cover">
            <% } else { %>
              <div class="w-full h-full bg-primary-200 flex items-center justify-center text-primary-700 font-bold text-2xl">
                <%= p.nama.charAt(0) %>
              </div>
            <% } %>
          </div>
          <h4 class="font-semibold text-gray-900 text-sm leading-tight mb-1"><%= p.nama %></h4>
          <p class="text-xs text-primary-600 font-medium"><%= p.jabatan %></p>
        </div>
      <% }) %>
    </div>

    <div class="text-center mt-8" data-aos="fade-up">
      <a href="/profil#perangkat" class="btn-secondary">Lihat Semua Perangkat</a>
    </div>
  </div>
</section>
<% } %>

<!-- ══ GALERI PREVIEW ═══════════════════════════════════════ -->
<% if (galeriList && galeriList.length > 0) { %>
<section class="section-pad bg-gray-50">
  <div class="container-wrap">
    <div class="text-center mb-12" data-aos="fade-up">
      <span class="badge-green mb-3">Galeri</span>
      <h2 class="section-heading">Foto Dusun Katekan</h2>
      <p class="section-sub">Koleksi foto kegiatan dan pemandangan indah Dusun Katekan.</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <% galeriList.forEach((g, i) => { %>
        <a href="<%= g.foto %>" class="glightbox relative group overflow-hidden rounded-xl aspect-square block" data-gallery="beranda" data-title="<%= g.judul || '' %>" data-aos="zoom-in" data-aos-delay="<%= (i % 4) * 50 %>">
          <img src="<%= g.foto %>" alt="<%= g.judul || 'Galeri Dusun' %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 lazy">
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
            <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
          </div>
        </a>
      <% }) %>
    </div>

    <div class="text-center mt-10" data-aos="fade-up">
      <a href="/galeri" class="btn-primary">Lihat Semua Foto</a>
    </div>
  </div>
</section>
<% } %>

<!-- ══ CTA ═══════════════════════════════════════════════════ -->
<section class="hero-gradient py-20">
  <div class="container-wrap text-center" data-aos="fade-up">
    <h2 class="text-3xl lg:text-4xl font-extrabold text-white mb-4 text-shadow">Bersama Membangun Dusun Katekan</h2>
    <p class="text-primary-200 text-lg mb-8 max-w-xl mx-auto">Bersatu, bergotong royong, dan berinovasi untuk mewujudkan dusun yang maju dan sejahtera.</p>
    <a href="/profil" class="btn-primary bg-white text-primary-800 hover:bg-primary-50 shadow-xl">
      Pelajari Profil Dusun
    </a>
  </div>
</section>

