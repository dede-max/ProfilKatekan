<% layout('layouts/main') %>

<!-- Page Header -->
<section class="hero-gradient py-20 relative overflow-hidden">
  <div class="container-wrap text-center relative z-10" data-aos="fade-up">
    <span class="badge bg-primary-400/20 text-primary-300 mb-4">Dokumentasi</span>
    <h1 class="text-4xl lg:text-5xl font-extrabold text-white mb-3 text-shadow">Galeri Foto</h1>
    <p class="text-primary-200 text-lg max-w-xl mx-auto">Koleksi foto kegiatan, pemandangan, dan kehidupan Dusun Katekan.</p>
  </div>
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 50" fill="white" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0 50L1440 50L1440 20C1200 40 960 50 720 50C480 50 240 35 0 20V50Z"/></svg>
  </div>
</section>

<!-- Gallery Grid -->
<section class="section-pad bg-gray-50">
  <div class="container-wrap">
    <% if (galeri && galeri.length > 0) { %>
      <p class="text-gray-400 text-sm mb-6" data-aos="fade-up"><%= galeri.length %> foto tersedia</p>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 lg:gap-4">
        <% galeri.forEach((g, i) => { %>
          <a href="<%= g.foto %>" class="glightbox group relative block overflow-hidden rounded-xl lg:rounded-2xl aspect-square shadow-sm hover:shadow-lg transition-shadow"
             data-gallery="galeri-dusun"
             data-title="<%= g.judul || 'Galeri Dusun Katekan' %>"
             data-description="<%= g.keterangan || '' %>"
             data-aos="zoom-in"
             data-aos-delay="<%= (i % 4) * 40 %>">
            <img src="<%= g.foto %>" alt="<%= g.judul || 'Foto Dusun' %>"
                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
            <!-- Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="absolute bottom-0 left-0 right-0 p-3">
                <% if (g.judul) { %>
                  <p class="text-white text-xs font-semibold truncate"><%= g.judul %></p>
                <% } %>
              </div>
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                <div class="w-10 h-10 bg-white/90 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-gray-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
              </div>
            </div>
          </a>
        <% }) %>
      </div>

    <% } else { %>
      <div class="text-center py-24" data-aos="fade-up">
        <div class="text-6xl mb-4">📷</div>
        <h3 class="text-xl font-bold text-gray-700 mb-2">Belum Ada Foto</h3>
        <p class="text-gray-400">Galeri foto akan segera hadir. Pantau terus website ini.</p>
      </div>
    <% } %>
  </div>
</section>
