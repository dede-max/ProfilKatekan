<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title + ' — Admin Dusun Katekan' : 'Admin Dusun Katekan' %>
  </title>
  <meta name="robots" content="noindex, nofollow">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">

  <link rel="stylesheet" href="/dist/main.css">
</head>

<body class="font-sans bg-gray-100 min-h-screen">

  <div class="flex min-h-screen">

    <!-- ── Sidebar ── -->
    <aside class="w-64 bg-gray-900 flex flex-col min-h-screen fixed top-0 left-0 z-30 hidden lg:flex">
      <!-- Logo -->
      <div class="px-6 py-6 border-b border-white/10">
        <a href="/admin/dashboard" class="flex items-center gap-3">
          <div class="w-9 h-9 bg-primary-600 rounded-xl flex items-center justify-center text-white font-bold text-lg">K
          </div>
          <div>
            <div class="text-white font-bold text-sm leading-tight">Dusun Katekan</div>
            <div class="text-gray-400 text-xs">Panel Admin</div>
          </div>
        </a>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 px-4 py-5 space-y-1 overflow-y-auto">
        <p class="text-xs text-gray-500 uppercase font-semibold tracking-wider px-4 mb-2">Menu Utama</p>

        <a href="/admin/dashboard" class="sidebar-link <%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Dashboard
        </a>

        <a href="/admin/profil" class="sidebar-link <%= currentPath.startsWith('/admin/profil') ? 'active' : '' %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
          Profil Dusun
        </a>

        <a href="/admin/perangkat"
          class="sidebar-link <%= currentPath.startsWith('/admin/perangkat') ? 'active' : '' %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          Perangkat Dusun
        </a>

        <a href="/admin/potensi" class="sidebar-link <%= currentPath.startsWith('/admin/potensi') ? 'active' : '' %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
          Potensi Dusun
        </a>

        <a href="/admin/galeri" class="sidebar-link <%= currentPath.startsWith('/admin/galeri') ? 'active' : '' %>">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Galeri Foto
        </a>

        <div class="border-t border-white/10 mt-4 pt-4">
          <a href="/" target="_blank" class="sidebar-link">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Lihat Website
          </a>
        </div>
      </nav>

      <!-- User info -->
      <div class="px-4 py-4 border-t border-white/10">
        <div class="flex items-center gap-3 px-2">
          <div
            class="w-8 h-8 bg-primary-600 rounded-full flex items-center justify-center text-white text-sm font-bold">
            <%= currentUser?.nama?.charAt(0)?.toUpperCase() || 'A' %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="text-white text-sm font-medium truncate">
              <%= currentUser?.nama || 'Admin' %>
            </div>
            <div class="text-gray-500 text-xs truncate">
              <%= currentUser?.email || '' %>
            </div>
          </div>
          <form action="/admin/logout" method="POST">
            <button type="submit" title="Logout" class="text-gray-400 hover:text-red-400 transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- ── Main Content ── -->
    <div class="flex-1 lg:ml-64 flex flex-col min-h-screen">

      <!-- Top bar (mobile) -->
      <header
        class="bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between lg:hidden sticky top-0 z-20">
        <a href="/admin/dashboard" class="flex items-center gap-2">
          <div class="w-7 h-7 bg-primary-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">K
          </div>
          <span class="font-bold text-gray-900 text-sm">Admin Katekan</span>
        </a>
        <button id="sidebar-toggle" class="p-2 text-gray-500 hover:text-gray-700">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </header>

      <!-- Flash -->
      <%- include('../partials/flash') %>

        <!-- Page content -->
        <main class="flex-1 p-4 lg:p-8">
          <%- body %>
        </main>

        <footer class="px-8 py-4 text-center text-xs text-gray-400 border-t border-gray-200">
          © <%= new Date().getFullYear() %> Web Dusun Katekan — Panel Admin
        </footer>
    </div>

  </div>

  <script src="/dist/main.js" defer></script>
  <script>
    // Mobile sidebar
    const toggle = document.getElementById('sidebar-toggle');
    const aside = document.querySelector('aside');
    toggle?.addEventListener('click', () => {
      aside?.classList.toggle('hidden');
      aside?.classList.toggle('flex');
    });
  </script>
</body>

</html>