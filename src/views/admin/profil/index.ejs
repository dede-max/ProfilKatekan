<% layout('layouts/admin') %>

<div class="space-y-6 max-w-4xl">

  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Profil Dusun</h1>
      <p class="text-gray-400 text-sm">Edit informasi dasar Dusun Katekan</p>
    </div>
    <a href="/" target="_blank" class="btn-secondary text-sm py-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      Lihat Website
    </a>
  </div>

  <form action="/admin/profil" method="POST" enctype="multipart/form-data" class="space-y-6">

    <!-- Informasi Dasar -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-bold text-gray-900 mb-5 pb-3 border-b border-gray-100">Informasi Dasar</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        <div class="form-group">
          <label class="form-label">Nama Dusun</label>
          <input type="text" name="nama_desa" class="form-input" value="<%= profil?.nama_desa || '' %>" placeholder="Dusun Katekan">
        </div>
        <div class="form-group">
          <label class="form-label">Kecamatan</label>
          <input type="text" name="kecamatan" class="form-input" value="<%= profil?.kecamatan || '' %>" placeholder="Gantiwarno">
        </div>
        <div class="form-group">
          <label class="form-label">Kabupaten</label>
          <input type="text" name="kabupaten" class="form-input" value="<%= profil?.kabupaten || '' %>" placeholder="Klaten">
        </div>
        <div class="form-group">
          <label class="form-label">Provinsi</label>
          <input type="text" name="provinsi" class="form-input" value="<%= profil?.provinsi || '' %>" placeholder="Jawa Tengah">
        </div>
        <div class="form-group">
          <label class="form-label">Kode Pos</label>
          <input type="text" name="kode_pos" class="form-input" value="<%= profil?.kode_pos || '' %>" placeholder="57455">
        </div>
        <div class="form-group">
          <label class="form-label">Telepon</label>
          <input type="text" name="telepon" class="form-input" value="<%= profil?.telepon || '' %>" placeholder="(0272) 321456">
        </div>
        <div class="form-group sm:col-span-2">
          <label class="form-label">Email Dusun</label>
          <input type="email" name="email_desa" class="form-input" value="<%= profil?.email_desa || '' %>" placeholder="admin@dusunkatekan.id">
        </div>
        <div class="form-group sm:col-span-2">
          <label class="form-label">Alamat Kantor</label>
          <textarea name="alamat_kantor" class="form-textarea" rows="2" placeholder="Dusun Katekan, Gantiwarno..."><%= profil?.alamat_kantor || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Statistik -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-bold text-gray-900 mb-5 pb-3 border-b border-gray-100">Statistik Dusun</h2>
      <div class="grid sm:grid-cols-3 gap-5">
        <div class="form-group">
          <label class="form-label">Luas Wilayah (Ha)</label>
          <input type="number" step="0.01" name="luas_wilayah" class="form-input" value="<%= profil?.luas_wilayah || '' %>" placeholder="1250.50">
        </div>
        <div class="form-group">
          <label class="form-label">Jumlah Penduduk</label>
          <input type="number" name="jumlah_penduduk" class="form-input" value="<%= profil?.jumlah_penduduk || '' %>" placeholder="4823">
        </div>
        <div class="form-group">
          <label class="form-label">Jumlah KK</label>
          <input type="number" name="jumlah_kk" class="form-input" value="<%= profil?.jumlah_kk || '' %>" placeholder="1245">
        </div>
      </div>
    </div>

    <!-- Visi Misi -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-bold text-gray-900 mb-5 pb-3 border-b border-gray-100">Visi & Misi</h2>
      <div class="space-y-5">
        <div class="form-group">
          <label class="form-label">Visi Dusun</label>
          <textarea name="visi" class="form-textarea" rows="3" placeholder="Terwujudnya Dusun Katekan yang..."><%= profil?.visi || '' %></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">Misi Dusun</label>
          <p class="form-hint mb-2">Tulis setiap poin misi di baris baru.</p>
          <textarea name="misi" class="form-textarea" rows="6" placeholder="1. Meningkatkan kualitas...&#10;2. Mengembangkan potensi..."><%= profil?.misi || '' %></textarea>
        </div>
      </div>
    </div>

    <!-- Sejarah -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-bold text-gray-900 mb-5 pb-3 border-b border-gray-100">Sejarah Dusun</h2>
      <div class="form-group">
        <label class="form-label">Sejarah</label>
        <textarea name="sejarah" class="form-textarea" rows="8" placeholder="Tuliskan sejarah Dusun Katekan..."><%= profil?.sejarah || '' %></textarea>
      </div>
    </div>

    <!-- Foto Kantor -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-bold text-gray-900 mb-5 pb-3 border-b border-gray-100">Foto Kantor Dusun</h2>
      <div class="flex gap-6 items-start flex-wrap">
        <% if (profil?.foto_kantor) { %>
          <img id="foto-preview" src="<%= profil.foto_kantor %>" alt="Foto Kantor" class="w-40 h-28 object-cover rounded-xl border border-gray-200">
        <% } else { %>
          <img id="foto-preview" class="w-40 h-28 object-cover rounded-xl border border-gray-200 hidden" alt="Preview">
        <% } %>
        <div class="flex-1 min-w-0">
          <label class="form-label">Unggah Foto Kantor</label>
          <input type="file" name="foto_kantor" accept="image/*" class="form-input py-2 text-sm" data-preview="foto-preview">
          <p class="form-hint">Format: JPEG, PNG, WebP. Maks 5MB.</p>
        </div>
      </div>
    </div>

    <!-- Video Profil Dusun -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <div class="flex items-center justify-between pb-3 mb-5 border-b border-gray-100">
        <div>
          <h2 class="font-bold text-gray-900 text-lg flex items-center gap-2">
            <span>🎬</span> Video Profil Dusun
          </h2>
          <p class="text-xs text-gray-400 mt-0.5">Video akan ditampilkan pada section khusus di Halaman Beranda</p>
        </div>
      </div>

      <!-- Current Video Status / Preview -->
      <% if (profil?.video_file || profil?.video_url) { %>
        <div class="mb-6 p-4 rounded-xl bg-gray-50 border border-gray-200">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Video Aktif Saat Ini</p>
          
          <% if (profil.video_file) { %>
            <div class="space-y-2">
              <div class="rounded-xl overflow-hidden bg-black max-w-lg aspect-video shadow-md">
                <video src="<%= profil.video_file %>" controls class="w-full h-full"></video>
              </div>
              <div class="flex items-center justify-between pt-1">
                <span class="text-xs text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-md font-medium">
                  📁 File Video Terupload
                </span>
                <label class="flex items-center gap-2 text-xs text-red-600 cursor-pointer hover:text-red-700">
                  <input type="checkbox" name="hapus_video_file" value="1" class="rounded text-red-600 focus:ring-red-500">
                  Hapus File Video Ini
                </label>
              </div>
            </div>
          <% } else if (profil.video_url) { %>
            <div class="space-y-2">
              <div class="text-xs text-gray-600 truncate mb-1">
                Link: <a href="<%= profil.video_url %>" target="_blank" class="text-primary-600 underline font-medium"><%= profil.video_url %></a>
              </div>
              <label class="flex items-center gap-2 text-xs text-red-600 cursor-pointer hover:text-red-700">
                <input type="checkbox" name="hapus_video_url" value="1" class="rounded text-red-600 focus:ring-red-500">
                Hapus Link Video Ini
              </label>
            </div>
          <% } %>
        </div>
      <% } %>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Opsi 1: Link YouTube / Video URL -->
        <div class="p-5 rounded-2xl bg-primary-50/50 border border-primary-100 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-7 h-7 rounded-lg bg-red-600 text-white flex items-center justify-center text-xs font-bold shadow-sm">▶</span>
              <h3 class="font-bold text-gray-900 text-sm">Opsi 1: Link YouTube / URL</h3>
            </div>
            <p class="text-xs text-gray-500 mb-3 leading-relaxed">
              Masukkan URL video YouTube (misal: <code>https://www.youtube.com/watch?v=...</code> atau <code>https://youtu.be/...</code>)
            </p>
            <div class="form-group mb-0">
              <label class="form-label text-xs">URL Video</label>
              <input type="url" name="video_url" class="form-input text-sm" value="<%= profil?.video_url || '' %>" placeholder="https://www.youtube.com/watch?v=...">
              <p class="form-hint">Otomatis di-embed secara responsif di Beranda.</p>
            </div>
          </div>
        </div>

        <!-- Opsi 2: Upload File Video -->
        <div class="p-5 rounded-2xl bg-gray-50 border border-gray-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <span class="w-7 h-7 rounded-lg bg-primary-600 text-white flex items-center justify-center text-xs font-bold shadow-sm">📁</span>
              <h3 class="font-bold text-gray-900 text-sm">Opsi 2: Upload File Video</h3>
            </div>
            <p class="text-xs text-gray-500 mb-3 leading-relaxed">
              Upload file video mandiri (MP4, WebM, MOV) langsung ke Supabase Storage.
            </p>
            <div class="form-group mb-0">
              <label class="form-label text-xs">Pilih File Video</label>
              <input type="file" name="video_file" accept="video/mp4,video/webm,video/quicktime,video/*" class="form-input py-2 text-sm">
              <p class="form-hint">Format: MP4, WebM, MOV. Disarankan video berdurasi singkat / terkompresi.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <button type="submit" class="btn-admin px-6 py-2.5 text-sm font-semibold">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        Simpan Semua Perubahan
      </button>
    </div>
  </form>

</div>
