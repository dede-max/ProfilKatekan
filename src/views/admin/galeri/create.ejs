<% layout('layouts/admin') %>

<div class="max-w-xl space-y-6">
  <div class="flex items-center gap-3">
    <a href="/admin/galeri" class="p-2 rounded-xl text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Upload Foto</h1>
      <p class="text-gray-400 text-sm">Tambahkan foto ke galeri dusun</p>
    </div>
  </div>

  <form action="/admin/galeri" method="POST" enctype="multipart/form-data" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-5">

    <!-- Foto Upload Area -->
    <div class="form-group">
      <label class="form-label">Foto <span class="text-red-500">*</span></label>
      <div class="mt-1">
        <img id="foto-preview" class="w-full h-56 object-cover rounded-xl border border-gray-200 mb-3 hidden" alt="Preview">
        <div id="upload-placeholder" class="w-full h-56 border-2 border-dashed border-gray-200 rounded-xl flex flex-col items-center justify-center text-gray-300 hover:border-primary-300 hover:bg-primary-50 transition-colors cursor-pointer mb-3">
          <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span class="text-sm font-medium">Klik untuk pilih foto</span>
          <span class="text-xs mt-1">JPEG, PNG, WebP — Maks 5MB</span>
        </div>
        <input type="file" id="foto-input" name="foto" accept="image/*" required class="form-input py-2 text-sm" data-preview="foto-preview">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label" for="judul">Judul Foto</label>
      <input type="text" id="judul" name="judul" class="form-input" placeholder="Kegiatan Gotong Royong Dusun">
    </div>

    <div class="form-group">
      <label class="form-label" for="keterangan">Keterangan</label>
      <textarea id="keterangan" name="keterangan" class="form-textarea" rows="2" placeholder="Deskripsi singkat foto..."></textarea>
    </div>

    <div class="flex gap-3 pt-2">
      <button type="submit" class="btn-admin px-6 py-2.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        Upload Foto
      </button>
      <a href="/admin/galeri" class="btn-secondary py-2.5 px-5 text-sm">Batal</a>
    </div>
  </form>
</div>

<script>
  // Show/hide upload placeholder based on file selection
  const input       = document.getElementById('foto-input');
  const placeholder = document.getElementById('upload-placeholder');
  const preview     = document.getElementById('foto-preview');

  placeholder?.addEventListener('click', () => input?.click());

  input?.addEventListener('change', function () {
    if (this.files?.[0]) {
      placeholder?.classList.add('hidden');
      preview?.classList.remove('hidden');
    }
  });
</script>
