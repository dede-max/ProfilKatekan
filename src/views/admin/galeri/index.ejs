<% layout('layouts/admin') %>

<div class="space-y-6">
  <!-- Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Galeri Foto</h1>
      <p class="text-gray-400 text-sm"><%= galeri.length %> foto tersedia</p>
    </div>
    <a href="/admin/galeri/create" class="btn-admin">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Upload Foto
    </a>
  </div>

  <!-- Grid -->
  <% if (galeri.length > 0) { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
      <% galeri.forEach(g => { %>
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden group">
          <div class="aspect-square relative overflow-hidden">
            <img src="<%= g.foto %>" alt="<%= g.judul || 'Foto Dusun' %>"
                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
          </div>
          <div class="p-3">
            <p class="font-semibold text-gray-800 text-xs truncate mb-0.5"><%= g.judul || '—' %></p>
            <p class="text-gray-400 text-xs truncate mb-3"><%= g.keterangan ? g.keterangan.substring(0, 40) : '—' %></p>
            <div class="flex gap-1.5">
              <a href="/admin/galeri/<%= g.id %>/edit" class="flex-1 text-center text-xs font-semibold py-1.5 rounded-lg bg-amber-100 text-amber-700 hover:bg-amber-200 transition-colors">Edit</a>
              <form action="/admin/galeri/<%= g.id %>/delete" method="POST" class="flex-1" data-confirm="Hapus foto '<%= g.judul || 'ini' %>'?">
                <button type="submit" class="w-full text-xs font-semibold py-1.5 rounded-lg bg-red-100 text-red-700 hover:bg-red-200 transition-colors">Hapus</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

  <% } else { %>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm text-center py-20">
      <div class="text-5xl mb-3">📷</div>
      <h3 class="font-bold text-gray-700 mb-1">Belum Ada Foto</h3>
      <p class="text-gray-400 text-sm mb-5">Unggah foto pertama untuk mengisi galeri.</p>
      <a href="/admin/galeri/create" class="btn-admin">Upload Foto</a>
    </div>
  <% } %>
</div>
