<% layout('layouts/admin') %>

<div class="max-w-2xl space-y-6">
  <!-- Header -->
  <div class="flex items-center gap-3">
    <a href="/admin/perangkat" class="p-2 rounded-xl text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Tambah Perangkat Dusun</h1>
      <p class="text-gray-400 text-sm">Isi form untuk menambahkan perangkat baru</p>
    </div>
  </div>

  <form action="/admin/perangkat" method="POST" enctype="multipart/form-data" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-5">
    <div class="form-group">
      <label class="form-label" for="nama">Nama Lengkap <span class="text-red-500">*</span></label>
      <input type="text" id="nama" name="nama" class="form-input" required placeholder="Budi Santoso, S.Sos">
    </div>

    <div class="form-group">
      <label class="form-label" for="jabatan">Jabatan <span class="text-red-500">*</span></label>
      <input type="text" id="jabatan" name="jabatan" class="form-input" required placeholder="Kepala Dusun / Bayan">
    </div>

    <div class="form-group">
      <label class="form-label" for="urutan">Urutan Tampil</label>
      <input type="number" id="urutan" name="urutan" class="form-input" min="1" max="999" placeholder="1" value="99">
      <p class="form-hint">Angka kecil tampil lebih awal. Kepala Dusun = 1</p>
    </div>

    <div class="form-group">
      <label class="form-label">Foto</label>
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <img id="foto-preview" class="w-20 h-20 rounded-xl object-cover border border-gray-200 hidden" alt="Preview">
          <div id="foto-placeholder" class="w-20 h-20 rounded-xl bg-gray-100 flex items-center justify-center text-gray-300">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          </div>
        </div>
        <div class="flex-1">
          <input type="file" name="foto" accept="image/*" class="form-input py-2 text-sm" data-preview="foto-preview">
          <p class="form-hint">Opsional. Format: JPEG, PNG, WebP. Maks 5MB.</p>
        </div>
      </div>
    </div>

    <div class="flex gap-3 pt-2">
      <button type="submit" class="btn-admin px-6 py-2.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Tambah Perangkat
      </button>
      <a href="/admin/perangkat" class="btn-secondary py-2.5 px-5 text-sm">Batal</a>
    </div>
  </form>
</div>
