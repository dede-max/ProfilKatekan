# Server
PORT=3000
NODE_ENV=development

# Session (ganti dengan string acak yang panjang dan aman!)
SESSION_SECRET=katekan-super-secret-session-key-ganti-ini-2024

# Supabase - Dapatkan dari https://app.supabase.com > Project > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage Bucket (buat bucket baru di Supabase Storage dengan nama ini)
SUPABASE_STORAGE_BUCKET=desa-katekan
